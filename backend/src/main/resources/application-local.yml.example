# 複製成 application-local.yml 並填入真實值（該檔已在 .gitignore）
# 取得位置：Cloudinary Dashboard → Settings → API Keys
#
#   copy application-local.yml.example application-local.yml
#
cardbeamz:
  cloudinary:
    cloud-name: ddawye3go
    api-key: YOUR_API_KEY
    api-secret: YOUR_API_SECRET
    base-folder: cardbeamz
